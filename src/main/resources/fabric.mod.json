{
  "schemaVersion": 1,
  "id": "wowdps",
  "version": "${version}",
  "name": "DPS & Spell Meter",
  "description": "Real-time DPS, damage, and spell analytics meter for Minecraft 1.20.1 Fabric. Features exact Spell Engine detection, weapon-to-spell breakdown, FTB Teams & Open Parties and Claims party integration, and freely resizable auto-adapting HUD & Inspector windows.",
  "authors": [
    "UniWest"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "dev.wowdps.WowDpsMod"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.wowdps.client.WowDpsClient"
      }
    ]
  },
  "mixins": [
    "wowdps.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.10.0"
  },
  "suggests": {
    "ftbteams": "*",
    "openpartiesandclaims": "*",
    "spell_engine": "*"
  }
}
